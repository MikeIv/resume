{
  "name": "resume-site",
  "type": "module",
  "private": true,
  "description": "Машиночитаемое и человекочитаемое резюме Михаила Иванова (Nuxt fullstack)",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "tsx scripts/preview.ts",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "hh:pack": "tsx scripts/emit-hh-pack.ts",
    "hh:login": "tsx scripts/hh-login.ts",
    "hh:shot": "tsx scripts/hh-shot.ts",
    "ats:pdf": "tsx scripts/emit-pdf.ts",
    "ats:docx": "tsx scripts/emit-docx.ts",
    "check:pdf": "tsx scripts/check-pdf.ts",
    "emit:social": "tsx scripts/emit-social.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "audit:site": "tsx scripts/lighthouse.ts",
    "build:all": "pnpm hh:pack && pnpm emit:social && pnpm generate && pnpm ats:pdf && pnpm ats:docx && pnpm check:pdf",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.{vue,css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{vue,css,scss}\" --fix --allow-empty-input",
    "lint:all": "eslint . && pnpm format:check && stylelint \"**/*.{vue,css,scss}\" --allow-empty-input",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "rules:sync": "node .cursor/sync-rules.mjs",
    "rules:check": "node .cursor/check-rules.mjs",
    "verify": "pnpm lint:all && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nuxt/icon": "^2.6.2",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^25.7.0",
    "chrome-launcher": "^1.2.2",
    "docx": "^9.15.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.0.4",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "postcss": "^8.5.14",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
